EDGE_DEVICE_ID=edge-mock-001
EDGE_MOCK=1
EDGE_DB_PATH=edge-platform/data/events.sqlite3
EDGE_OPERATOR_TOKEN=replace-with-random-local-token
EDGE_UI_ORIGIN=http://127.0.0.1:5173
# Optional on Orange Pi. Use a local absolute BMP path on Windows.
# EDGE_DEPTH_PREVIEW_PATH=/path/to/camera/live/depth.bmp
# EDGE_CLOUD_URL=https://your-cloud.example
# EDGE_CLOUD_TOKEN=replace-with-device-token
# Enable cloud PPG task polling on the CIX board with EDGE_MOCK=0.
# EDGE_SLEEP_STAGE_ASSETS=/path/to/verified/ppg-assets

# ARM64 static posture workbench. The launcher exports these values.
# EDGE_DEPTH_ASSETS=/path/to/verified/depth-assets
# EDGE_DEPTH_INTERFACE=/path/to/verified/depth_posture_infer.py
# EDGE_DEPTH_NPU_PYTHON=/path/to/noe-venv/bin/python
# EDGE_DEPTH_RUN_DIR=/path/to/private/run-evidence
