# Run backend/scripts/init_dev.py to generate real LOCAL credentials.
POSTGRES_USER=health
POSTGRES_DB=health_monitor
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+psycopg://health:REPLACE@127.0.0.1:5433/health_monitor
CURSOR_SECRET=
# JSON identities: subject, role (device/operator), devices, token_sha256, optional revoked
CLOUD_IDENTITIES=[]
MOCK_DEVICE_TOKEN=
MOCK_WORKER_ENABLED=true
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
